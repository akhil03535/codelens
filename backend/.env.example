# App
APP_NAME=CodeLens AI
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
API_VERSION=1.0.0
LOG_LEVEL=INFO

# Security
# Generate locally, for example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Database
# Supabase dashboard > Project Settings > Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/codelens_prod
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/codelens_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Supabase
# Supabase dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Neo4j
# Neo4j Aura dashboard or your local Neo4j instance
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_ENABLED=false

# Redis
# Local Redis or a hosted Redis provider
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Firebase
# Firebase Console > Project settings > Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_AUTH_ENABLED=true

# Groq
# Groq Console > API keys
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT=60
GROQ_MAX_TOKENS=4096
GROQ_MAX_RETRIES=3

# Embeddings and RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=7

# Stripe
# Stripe Dashboard > Developers > API keys and Webhooks
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_YEARLY=

# Cloudflare R2
# Cloudflare Dashboard > R2 > Manage R2 API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=codelens-uploads
R2_ENABLED=false

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Monitoring and analytics
# Sentry project settings / PostHog project settings
SENTRY_DSN=
SENTRY_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_ENABLED=false

# OAuth
# GitHub > Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Jobs and caching
QUEUE_ENABLED=true
WORKER_CONCURRENCY=4
JOB_TIMEOUT_SECONDS=3600
MAX_RETRIES=3
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000
ENABLE_RESPONSE_COMPRESSION=true
